# RocketRide project env — the VS Code extension auto-manages the first two from its settings.
# Everything a .pipe references MUST be ROCKETRIDE_*-prefixed (pipeline rule), so we wrap our
# Butterbase + Neo4j creds under ROCKETRIDE_ names here.

# --- managed by the RocketRide extension (rocketride.hostUrl + API key) ---
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key

# --- custom vars referenced by fleet-analyst.pipe ---
# Butterbase AI gateway (OpenAI-compatible) for the two LLM nodes:
ROCKETRIDE_GATEWAY_URL=https://api.butterbase.ai/v1/app_hbas8u7mao1y
ROCKETRIDE_GATEWAY_KEY=bb_sk_your_service_key
ROCKETRIDE_MODEL=anthropic/claude-sonnet-4.6

# Neo4j Aura for the graph-query node (user AND database are the instance id, not "neo4j"):
ROCKETRIDE_NEO4J_URI=neo4j+s://7a6461d0.databases.neo4j.io
ROCKETRIDE_NEO4J_USER=7a6461d0
ROCKETRIDE_NEO4J_DATABASE=7a6461d0
ROCKETRIDE_NEO4J_PASSWORD=your-neo4j-password
