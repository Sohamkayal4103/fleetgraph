# RocketRide project env. The RocketRide VS Code extension auto-manages the first two from its
# settings (rocketride.hostUrl + API key). Everything a .pipe references MUST be ROCKETRIDE_*-prefixed.

# --- managed by the RocketRide extension ---
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key

# --- referenced by fleet-analyst.pipe (the llm_openai node → Butterbase AI gateway) ---
# The FastAPI app injects these at runtime from its own BUTTERBASE_* vars (see rocketride_client.py),
# so you only need them here for standalone runs / the VS Code extension.
ROCKETRIDE_GATEWAY_URL=https://api.butterbase.ai/v1/app_hbas8u7mao1y
ROCKETRIDE_GATEWAY_KEY=bb_sk_your_service_key
ROCKETRIDE_MODEL=anthropic/claude-sonnet-4.6
