# Copy to .env and fill in your Neo4j Aura password. dev.sh loads this automatically.
NEO4J_URI=neo4j+s://7a6461d0.databases.neo4j.io
NEO4J_USER=7a6461d0
NEO4J_DATABASE=7a6461d0
NEO4J_PASSWORD=your-neo4j-password-here

# Butterbase backend — DB, email auth, AI gateway. From `init_app` / dashboard:
#   BUTTERBASE_API_URL  = API origin (auth lives at {url}/auth/{app_id}, data at {url}/v1/{app_id})
#   BUTTERBASE_APP_ID   = your app id (app_xxxxxxxx)
#   BUTTERBASE_GATEWAY_URL = {API_URL}/v1/{APP_ID}  (OpenAI-compatible; +/chat/completions)
#   BUTTERBASE_API_KEY  = bb_sk_... service key (account-scoped, ai:gateway scope)
#   BUTTERBASE_MODEL    = a gateway model id, e.g. anthropic/claude-sonnet-4.6
BUTTERBASE_API_URL=https://api.butterbase.ai
BUTTERBASE_APP_ID=app_xxxxxxxxxxxx
BUTTERBASE_GATEWAY_URL=https://api.butterbase.ai/v1/app_xxxxxxxxxxxx
BUTTERBASE_API_KEY=bb_sk_...
BUTTERBASE_MODEL=anthropic/claude-sonnet-4.6

# RocketRide deployed pipeline webhook (from cloud.rocketride.ai after deploying fleet-analyst).
# When set, the app's "Ask" calls this instead of the local Cypher catalog.
ROCKETRIDE_WEBHOOK_URL=
