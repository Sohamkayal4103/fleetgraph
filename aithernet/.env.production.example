# =============================================================================
# Aithernet Stage 14F — single-host production environment template
# =============================================================================
#
#   !!! THIS FILE CONTAINS PLACEHOLDERS ONLY — NEVER REAL SECRETS !!!
#
# How to use:
#   1. Copy this file to an operator-managed env file OUTSIDE git, e.g.
#          install -m 0600 .env.production.example /etc/aithernet/hosted.env
#   2. Generate every real secret OUTSIDE git, e.g.:
#          openssl rand -hex 32      # session key / admin / ingestion tokens
#          openssl rand -base64 24   # database / minio passwords
#      and a release signing keypair (kept off-host / in a KMS).
#   3. Fill in real values in /etc/aithernet/hosted.env (mode 0600).
#   4. NEVER paste real credentials back into this example file.
#
# Production mode FAILS CLOSED at startup on any placeholder, missing required
# value, loopback public URL, insecure cookie, SQLite central DB, development
# email sink, or still-enabled bootstrap (see services/control_plane/config.py
# and `aithernet-hosted check`). Placeholder hostnames are *.example.invalid and
# are intentionally non-routable — replace them with your real domain.
# =============================================================================

# -----------------------------------------------------------------------------
# Control plane — `python -m services.control_plane`
# -----------------------------------------------------------------------------
AITHERNET_HOSTED_ENV=production
AITHERNET_HOSTED_HOST=0.0.0.0
AITHERNET_HOSTED_PORT=8100

# Central database — PostgreSQL only in production (never SQLite). The compose
# stack runs postgres as service `postgres` on the internal network.
AITHERNET_HOSTED_DATABASE_URL=postgresql://aithernet:REPLACE_WITH_DB_PASSWORD@postgres:5432/aithernet

# -- Session signing + CSRF/cookie settings -----------------------------------
# Session signing key (secret). Generate with `openssl rand -hex 32`.
AITHERNET_HOSTED_SESSION_KEY=REPLACE_WITH_SESSION_KEY_HEX
# Secure cookies are MANDATORY in production (HTTPS only). The CSRF token is a
# double-submit value bound to the per-session secret; SameSite=lax by default.
AITHERNET_HOSTED_COOKIE_SECURE=1

# -- First platform-admin bootstrap reference ---------------------------------
# Used by `aithernet-hosted admin bootstrap`. Set BOOTSTRAP=1 ONLY for the first
# boot, then return it to 0. Provide the admin password via this reference (or
# use --generate-secret / --password-fd) — never commit a real password.
AITHERNET_HOSTED_BOOTSTRAP=0
AITHERNET_HOSTED_ADMIN_EMAIL=ops@example.invalid
AITHERNET_HOSTED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_BOOTSTRAP_PASSWORD

# -- Email (SMTP) -------------------------------------------------------------
# `smtp` in production; `development` selects the in-memory sink (NON-production).
AITHERNET_HOSTED_EMAIL=smtp
AITHERNET_HOSTED_SMTP_URL=smtp://USERNAME:REPLACE_WITH_SMTP_PASSWORD@smtp.example.invalid:587

# -- Object storage -----------------------------------------------------------
# `local` uses the blobs volume; `s3` targets the MinIO/S3 endpoint below.
AITHERNET_HOSTED_STORAGE_BACKEND=local
AITHERNET_HOSTED_BLOB_ROOT=/var/lib/aithernet/blobs
AITHERNET_HOSTED_S3_ENDPOINT=http://minio:9000
AITHERNET_HOSTED_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
AITHERNET_HOSTED_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY

# -- Release signing / verification -------------------------------------------
# References to the signing seed + verification public key (mounted file paths
# or KMS references). Do NOT inline private key material.
AITHERNET_RELEASE_SIGNING_KEY=REPLACE_WITH_RELEASE_SIGNING_KEY_REF
AITHERNET_RELEASE_PUBLIC_KEY=REPLACE_WITH_RELEASE_PUBLIC_KEY_REF

# -- Data pseudonymization (node-side Stage 14E reference) --------------------
# High-entropy master secret reference for pseudonymization (>=256-bit). Nodes
# read this; documented here so operators provision it consistently.
AITHERNET_DP_PSEUDONYM_SECRET=REPLACE_WITH_PSEUDONYMIZATION_SECRET_B64

# -- Google Drive archive destination (Stage 14E, optional) -------------------
# Credential / folder / encryption references for the encrypted archive sink.
AITHERNET_DRIVE_CREDENTIALS_REF=REPLACE_WITH_DRIVE_CREDENTIALS_REF
AITHERNET_DRIVE_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID
AITHERNET_DRIVE_ENCRYPTION_KEY_REF=REPLACE_WITH_DRIVE_ENCRYPTION_KEY_REF

# -- Backup destination / encryption ------------------------------------------
AITHERNET_BACKUP_DESTINATION=REPLACE_WITH_BACKUP_DESTINATION
AITHERNET_BACKUP_ENCRYPTION_KEY_REF=REPLACE_WITH_BACKUP_ENCRYPTION_KEY_REF

# -----------------------------------------------------------------------------
# Public URLs — MUST be HTTPS in production. Replace *.example.invalid.
# -----------------------------------------------------------------------------
AITHERNET_PUBLIC_SITE_BASE_URL=https://www.example.invalid
AITHERNET_PORTAL_BASE_URL=https://app.example.invalid
AITHERNET_CONTROL_PLANE_BASE_URL=https://api.example.invalid
AITHERNET_INGESTION_BASE_URL=https://ingest.example.invalid
AITHERNET_DOWNLOAD_BASE_URL=https://downloads.example.invalid

# -----------------------------------------------------------------------------
# Ingestion service — `python -m services.ingestion`
# -----------------------------------------------------------------------------
INGEST_HOST=0.0.0.0
INGEST_PORT=8090
INGEST_DATABASE_URL=postgresql://aithernet:REPLACE_WITH_DB_PASSWORD@postgres:5432/aithernet
INGEST_BLOB_ROOT=/var/lib/aithernet/ingest-blobs
# Ingestion authentication references. Admin token: `openssl rand -hex 32`.
# Optional per-deployment batch decryption key reference (names an env var).
INGEST_ADMIN_TOKEN=REPLACE_WITH_INGEST_ADMIN_TOKEN
INGEST_DECRYPTION_KEY_REF=

# -----------------------------------------------------------------------------
# PostgreSQL container credentials (service `postgres`). Keep consistent with
# the *_DATABASE_URL values above.
# -----------------------------------------------------------------------------
POSTGRES_USER=aithernet
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=aithernet

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object store) root credentials (service `minio`). Keep
# consistent with AITHERNET_HOSTED_S3_ACCESS_KEY / SECRET_KEY above.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=REPLACE_WITH_S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_S3_SECRET_KEY

# -----------------------------------------------------------------------------
# Reverse proxy (Caddy) ACME registration email for Let's Encrypt.
# -----------------------------------------------------------------------------
ACME_EMAIL=ops@example.invalid
