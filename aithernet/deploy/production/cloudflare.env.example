# =============================================================================
# Aithernet — PRODUCTION env template for the Cloudflare Tunnel (app/admin) deploy
# =============================================================================
#
#   !!! PLACEHOLDERS ONLY — NEVER REAL SECRETS. NEVER COMMIT THE FILLED FILE. !!!
#
# Copy OUTSIDE git and fill in real values generated locally:
#     sudo install -d -m 0750 /etc/aithernet
#     sudo install -m 0600 deploy/production/cloudflare.env.example /etc/aithernet/hosted.env
#     sudo $EDITOR /etc/aithernet/hosted.env
#
# Generate secrets locally (never in chat):
#     openssl rand -hex 32      # AITHERNET_HOSTED_SESSION_KEY, INGEST_ADMIN_TOKEN
#     openssl rand -base64 24   # POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD, S3 keys
#
# Production mode FAILS CLOSED at startup on any leftover placeholder, missing
# required value, non-HTTPS / loopback public URL, insecure cookie, SQLite central
# DB, the development email sink, or a still-enabled bootstrap
# (services/control_plane/config.py + `deploy/production/check.sh`).
#
# Differences from .env.production.example: this profile is fronted by a Cloudflare
# Tunnel (no ACME, no public 80/443). The proxy publishes a LOOPBACK origin port
# that only cloudflared reaches. app + admin share one backend.
# =============================================================================

# --- environment + database --------------------------------------------------
AITHERNET_HOSTED_ENV=production
AITHERNET_HOSTED_HOST=0.0.0.0
AITHERNET_HOSTED_PORT=8100
AITHERNET_HOSTED_DATABASE_URL=postgresql://aithernet:REPLACE_WITH_DB_PASSWORD@postgres:5432/aithernet

# --- session / cookies / CSRF ------------------------------------------------
# 32+ hex chars. Secure cookies MANDATORY (HTTPS via Cloudflare). Host-only,
# SameSite=Lax. Do NOT broaden the cookie Domain across subdomains.
AITHERNET_HOSTED_SESSION_KEY=REPLACE_WITH_SESSION_KEY_HEX
AITHERNET_HOSTED_COOKIE_SECURE=1

# --- first admin bootstrap (set BOOTSTRAP=1 ONLY for first boot, then 0) ------
AITHERNET_HOSTED_BOOTSTRAP=0
AITHERNET_HOSTED_ADMIN_EMAIL=adityapawar@aithernet.online
AITHERNET_HOSTED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_BOOTSTRAP_PASSWORD

# --- email (SMTP) — see deploy/production/README.smtp.md ----------------------
# `smtp` in production (`development` is the in-memory sink, rejected in prod).
AITHERNET_HOSTED_EMAIL=smtp
AITHERNET_HOSTED_SMTP_URL=smtp://REPLACE_WITH_SMTP_USERNAME:REPLACE_WITH_SMTP_PASSWORD@smtp.zoho.com:587

# --- object storage ----------------------------------------------------------
AITHERNET_HOSTED_STORAGE_BACKEND=local
AITHERNET_HOSTED_BLOB_ROOT=/var/lib/aithernet/blobs
AITHERNET_HOSTED_S3_ENDPOINT=http://minio:9000
AITHERNET_HOSTED_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
AITHERNET_HOSTED_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY

# --- release signing / verification (references, not inline private keys) -----
AITHERNET_RELEASE_SIGNING_KEY=REPLACE_WITH_RELEASE_SIGNING_KEY_REF
AITHERNET_RELEASE_PUBLIC_KEY=REPLACE_WITH_RELEASE_PUBLIC_KEY_REF
AITHERNET_RELEASE_SIGNING_KEY_ID=
AITHERNET_RELEASE_SIGNING_KEYS=

# --- data pseudonymization (Stage 14E, >=256-bit) ----------------------------
AITHERNET_DP_PSEUDONYM_SECRET=REPLACE_WITH_PSEUDONYMIZATION_SECRET_B64

# --- Google Drive archive (legacy Stage 14E path; OUT OF SCOPE here) ----------
AITHERNET_DRIVE_CREDENTIALS_REF=
AITHERNET_DRIVE_FOLDER_ID=
AITHERNET_DRIVE_ENCRYPTION_KEY_REF=

# --- Owner archive Google OAuth (beta.9; admin/owner connects Drive server-side) ----
# Optional. When set, the admin portal → Research → "Connect Google Drive" runs a
# server-side OAuth consent flow (no refresh-token pasting) and the archive worker
# writes accepted packages to the OWNER's Drive (least-privilege drive.file scope).
# When EMPTY, the admin portal shows "Google Drive OAuth is not configured on the
# server" and archive jobs stay queued — clients are unaffected either way.
#   1. Google Cloud → Credentials → OAuth client ID → "Web application".
#   2. Enable the Google Drive API for the project.
#   3. Add this exact Authorized redirect URI (admin origin proxies /api -> control plane):
#        https://admin.aithernet.online/api/v1/admin/research/drive/oauth/callback
#   The client SECRET is read only at use time and is never logged or returned to any browser.
# See docs/owner-drive-oauth.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ARCHIVE_ROOT_NAME=

# --- backup destination / encryption -----------------------------------------
AITHERNET_BACKUP_DESTINATION=REPLACE_WITH_BACKUP_DESTINATION
AITHERNET_BACKUP_ENCRYPTION_KEY_REF=REPLACE_WITH_BACKUP_ENCRYPTION_KEY_REF

# -----------------------------------------------------------------------------
# Public URLs — MUST be HTTPS in production. www.aithernet.online is now the ONE
# canonical CUSTOMER origin: the public site, /login, /app and the same-origin
# /api all live there (the Caddy origin path-routes app/api to containers and
# reverse-proxies the marketing paths to GitHub Pages). admin.aithernet.online is
# the SEPARATE administrator origin (Cloudflare Access). During the compatibility
# window the NODE-FACING base URLs stay on app.aithernet.online so installed
# beta.4 nodes are untouched — app./v1/node, /v1/downloads and /ingest keep
# working. The browser portal calls the API same-origin (relative /api), so its
# base URL is www, and invitation links become https://www.aithernet.online/app/...
# -----------------------------------------------------------------------------
AITHERNET_PUBLIC_SITE_BASE_URL=https://www.aithernet.online
AITHERNET_PORTAL_BASE_URL=https://www.aithernet.online
AITHERNET_ADMIN_BASE_URL=https://admin.aithernet.online
# Node-facing (KEEP on app during the compat window; www also routes these):
AITHERNET_CONTROL_PLANE_BASE_URL=https://app.aithernet.online
AITHERNET_INGESTION_BASE_URL=https://app.aithernet.online
AITHERNET_DOWNLOAD_BASE_URL=https://app.aithernet.online

# -----------------------------------------------------------------------------
# Cloudflare origin binding + hostnames (consumed by the cloudflare override +
# Caddyfile.cloudflare). The proxy publishes ONLY 127.0.0.1:<bind>:80; cloudflared
# forwards app/admin to it. Never bind 0.0.0.0; never open a router/NAT port.
# -----------------------------------------------------------------------------
AITHERNET_ORIGIN_HTTP_BIND=8087
AITHERNET_WWW_HOST=www.aithernet.online
AITHERNET_APP_HOST=app.aithernet.online
AITHERNET_ADMIN_HOST=admin.aithernet.online

# --- ingestion service -------------------------------------------------------
INGEST_HOST=0.0.0.0
INGEST_PORT=8090
INGEST_DATABASE_URL=postgresql://aithernet:REPLACE_WITH_DB_PASSWORD@postgres:5432/aithernet
INGEST_BLOB_ROOT=/var/lib/aithernet/ingest-blobs
INGEST_ADMIN_TOKEN=REPLACE_WITH_INGEST_ADMIN_TOKEN
INGEST_DECRYPTION_KEY_REF=

# --- PostgreSQL container creds (keep consistent with *_DATABASE_URL) ---------
POSTGRES_USER=aithernet
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=aithernet

# --- MinIO root creds (keep consistent with the S3 keys above) ---------------
MINIO_ROOT_USER=REPLACE_WITH_S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_S3_SECRET_KEY

# ACME is NOT used in this profile (Cloudflare terminates TLS). Left for parity.
ACME_EMAIL=adityapawar@aithernet.online
