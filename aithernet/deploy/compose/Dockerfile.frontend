# =============================================================================
# Aithernet hosted frontend image (public site + customer + admin portal).
# Tracked, maintained, multi-stage. Build context is the repository root so the
# Node stage can build portal/ FROM SOURCE — there is NO committed portal/dist
# and NO operator-prepared deploy/static directory.
#   docker build -f deploy/compose/Dockerfile.frontend -t aithernet/frontend:latest .
# The same image serves either surface; the listen port comes from NGINX_PORT
# (8102 portal, 8101 public site), rendered by the nginx image's envsubst.
# =============================================================================

FROM node:22-alpine AS build
WORKDIR /app
# The image only builds the SPA; never download the puppeteer browser-test Chromium here.
ENV PUPPETEER_SKIP_DOWNLOAD=1
# Install dependencies from the lockfile first (reproducible, cache-friendly).
COPY portal/package.json portal/package-lock.json ./
RUN npm ci
# Build the SPA from source (tsc typecheck + vite build -> /app/dist).
COPY portal/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
# Drop the stock default site; serve the built SPA with history-API fallback.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/compose/nginx/spa.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_PORT=8102
EXPOSE 8101 8102
