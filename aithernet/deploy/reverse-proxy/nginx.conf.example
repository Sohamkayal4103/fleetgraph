# =============================================================================
# Aithernet Stage 14F — Nginx reverse-proxy template (ALTERNATIVE to Caddy)
# =============================================================================
#
#   This is an ALTERNATIVE to the primary supported Caddyfile. Use ONE proxy,
#   not both. Caddy (deploy/reverse-proxy/Caddyfile) is the primary supported
#   template and handles ACME/TLS automatically; with Nginx you must provision
#   and renew certificates yourself (e.g. certbot) and point ssl_certificate /
#   ssl_certificate_key at the real PEM files.
#
# Replace *.example.invalid with the real domain. Postgres/MinIO/admin-only
# ports are NEVER proxied. No open proxy, no directory listing (autoindex off
# is the nginx default and is not re-enabled anywhere here).
# =============================================================================

# Upstreams (internal docker service names / loopback).
upstream aithernet_public_site { server public-site:8101; }
upstream aithernet_portal      { server portal:8102; }
upstream aithernet_control_plane { server control-plane:8100; }
upstream aithernet_ingestion   { server ingestion:8090; }

# Shared security headers (included per server block).
# (Defined as a map-free snippet; copy the add_header lines into each block, or
#  use `include` of a file containing them.)

# WebSocket upgrade mapping.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------------------------
# HTTP :80 -> permanent redirect to HTTPS for every host.
# -----------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name www.example.invalid app.example.invalid api.example.invalid
                ingest.example.invalid downloads.example.invalid;

    # Allow ACME http-01 challenge if using certbot webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# -----------------------------------------------------------------------------
# Public marketing site -> public-site:8101
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.example.invalid;

    ssl_certificate     /etc/nginx/certs/www.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/www.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    client_max_body_size 1m;

    location / {
        proxy_pass http://aithernet_public_site;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -----------------------------------------------------------------------------
# Portal / admin SPA -> portal:8102
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.invalid;

    ssl_certificate     /etc/nginx/certs/app.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/app.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    client_max_body_size 4m;

    location / {
        proxy_pass http://aithernet_portal;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -----------------------------------------------------------------------------
# Control-plane API -> control-plane:8100 (small bodies). Health at /health/ready.
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.example.invalid;

    ssl_certificate     /etc/nginx/certs/api.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/api.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    client_max_body_size 2m;

    location / {
        proxy_pass http://aithernet_control_plane;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# -----------------------------------------------------------------------------
# Ingestion uploads -> ingestion:8090 (~32MB bodies). Readiness /ingest/v1/readiness.
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ingest.example.invalid;

    ssl_certificate     /etc/nginx/certs/ingest.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/ingest.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    client_max_body_size 32m;

    location / {
        proxy_pass http://aithernet_ingestion;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }
}

# -----------------------------------------------------------------------------
# Downloads -> control-plane:8100, path-scoped to /v1/downloads only.
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name downloads.example.invalid;

    ssl_certificate     /etc/nginx/certs/downloads.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/downloads.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    server_tokens off;

    client_max_body_size 1m;

    # Only the downloads path is exposed; everything else 404s.
    location /v1/downloads {
        proxy_pass http://aithernet_control_plane;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
